{
  "name": "operations-intelligence",
  "version": "1.0.0",
  "description": "A production-oriented TypeScript backend that maintains an explainable view of operational state across an industrial distribution network.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "scenario": "tsx src/scenarios/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm test && npm run test:integration && npm run scenario && npm run typecheck",
    "ready": "npm run format && npm run verify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackcritzer/operations-intelligence.git"
  },
  "keywords": [],
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jackcritzer/operations-intelligence/issues"
  },
  "homepage": "https://github.com/jackcritzer/operations-intelligence#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.11.2",
    "pg": "^8.23.0"
  }
}
