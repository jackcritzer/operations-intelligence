{
  "name": "operations-intelligence",
  "version": "1.0.0",
  "description": "A production-oriented TypeScript backend that maintains an explainable view of operational state across an industrial distribution network.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "scenario": "tsx src/scenarios/cli.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm test && npm run test:integration && npm run scenario && npm run typecheck && npm run build && npm run explorer:check",
    "ready": "npm run format && npm run verify",
    "dev": "tsx watch src/server.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "explorer:data": "tsx src/demo/generate-impact-explorer-data.ts",
    "explorer:dev": "npm run explorer:data && vite --config explorer/vite.config.ts",
    "explorer:typecheck": "tsc --noEmit -p explorer/tsconfig.json",
    "explorer:build": "npm run explorer:data && npm run explorer:typecheck && vite build --config explorer/vite.config.ts",
    "explorer:check": "npm run explorer:build && git diff --exit-code -- explorer/public/data/shipment-delay-blocks-order.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackcritzer/operations-intelligence.git"
  },
  "keywords": [],
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jackcritzer/operations-intelligence/issues"
  },
  "homepage": "https://github.com/jackcritzer/operations-intelligence#readme",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "^6.1.0",
    "@sinclair/typebox": "^0.34.52",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
